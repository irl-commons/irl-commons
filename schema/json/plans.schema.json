{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "about": {
      "type": "string",
      "pattern": "\\S"
    },
    "carriers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "network_type": {
            "type": "string",
            "enum": [
              "MNO",
              "MVNO"
            ]
          },
          "host_network_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "esim": {
            "type": "boolean"
          },
          "official_url": {
            "type": "string",
            "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$"
          },
          "coverage_map_url": {
            "type": "string",
            "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$"
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$"
                }
              },
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "checked_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "plans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "data_cap_gb": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "throttle_after_cap_kbps": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tethering_allowed": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "roaming_routing": {
                  "type": "string",
                  "enum": [
                    "home-routed",
                    "local-breakout",
                    "unknown"
                  ]
                },
                "source_url": {
                  "type": "string",
                  "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$"
                },
                "checked_on": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": [
                "id",
                "name",
                "data_cap_gb",
                "throttle_after_cap_kbps",
                "tethering_allowed",
                "roaming_routing",
                "source_url",
                "checked_on"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "country",
          "network_type",
          "host_network_id",
          "esim",
          "official_url",
          "coverage_map_url",
          "sources",
          "checked_on"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "about",
    "carriers"
  ],
  "additionalProperties": false,
  "title": "plans.json"
}
