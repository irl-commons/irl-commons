{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "about": {
      "type": "string",
      "description": "What this file holds, in a sentence or two, with a link to the docs."
    },
    "words": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Permanent id, used as an anchor and in links from other files."
          },
          "checked_on": {
            "description": "The day the entry was compared with its public source. Left out when no check is recorded; freshness is then unknown.",
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "term": {
            "type": "string",
            "pattern": "\\S",
            "description": "The word as streamers use it."
          },
          "also_called": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "description": "True synonyms: other names for exactly this thing. With a naming block, each one is the label or an also-used alternative."
          },
          "search_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "description": "For search only, never shown as a name: plurals, units, spellings and nearby phrases."
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "deprecated": true,
            "description": "Deprecated, kept for one release. Generated by `bun run aliases` from the label, also_called, the plural, the other names and search_terms."
          },
          "tier": {
            "type": "string",
            "enum": [
              "core",
              "more"
            ],
            "description": "core: the few basics people meet first. more: everything else."
          },
          "who": {
            "type": "string",
            "enum": [
              "streamer",
              "helper",
              "both"
            ],
            "description": "Who usually meets the word."
          },
          "heard_when": {
            "type": "string",
            "description": "When the word comes up, in one sentence. May be empty."
          },
          "plain": {
            "type": "string",
            "pattern": "\\S",
            "description": "The explanation in simple language. It says what the word means, not how to fix anything."
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": "Ids of related words in words.json."
          },
          "source": {
            "type": "string",
            "pattern": "\\S",
            "description": "A public source for the explanation."
          },
          "uncertain": {
            "type": "boolean",
            "description": "True while the explanation is not settled."
          },
          "l10n": {
            "description": "Translations by language tag, such as es-419 or pt-BR. A native speaker reads each one before it is published.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "term": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "The term in that language. Usually the scene's English word."
                },
                "plain": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "The explanation, in that language."
                },
                "heard_when": {
                  "description": "When the word comes up, in that language.",
                  "type": "string"
                }
              },
              "required": [
                "term",
                "plain"
              ],
              "additionalProperties": false
            }
          },
          "naming": {
            "description": "A naming guide for app makers: a recommended label for one screen or setting. Advice, not the only right name.",
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 40,
                "pattern": "\\S",
                "description": "The recommended label for the place in scope."
              },
              "short_label": {
                "description": "A shorter label for tight spaces.",
                "type": "string",
                "maxLength": 20,
                "pattern": "\\S"
              },
              "case": {
                "type": "string",
                "enum": [
                  "sentence",
                  "proper",
                  "acronym"
                ],
                "description": "How the label is written: sentence case (\"Relay server\"; acronyms stay capitals), a proper name, or an acronym (\"BRB\")."
              },
              "plural": {
                "description": "The plural of the label.",
                "type": "string",
                "maxLength": 40,
                "pattern": "\\S"
              },
              "scope": {
                "type": "string",
                "maxLength": 200,
                "pattern": "\\S",
                "description": "Where the label fits: the screen or setting it names."
              },
              "why": {
                "type": "string",
                "maxLength": 300,
                "pattern": "\\S",
                "description": "Why this label, about the word, never about a maker."
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "term": {
                      "type": "string",
                      "maxLength": 60,
                      "pattern": "\\S",
                      "description": "The other name."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "also-used",
                        "narrower",
                        "technical",
                        "ambiguous"
                      ],
                      "description": "also-used: means the same thing. narrower: one part or one kind of it. technical: the engineering name. ambiguous: here it can also mean something else."
                    },
                    "why": {
                      "description": "Why it isn't the recommended label here, about the word. Required unless the status is also-used.",
                      "type": "string",
                      "maxLength": 200,
                      "pattern": "\\S"
                    },
                    "see": {
                      "description": "The word this name normally means, for an ambiguous, narrower or product-specific also-used name.",
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "seen_in": {
                      "description": "Service ids whose evidence shows exactly this name. Never on ambiguous names.",
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      }
                    }
                  },
                  "required": [
                    "term",
                    "status"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "not": {
                              "const": "also-used"
                            }
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "why"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "ambiguous"
                          }
                        }
                      },
                      "then": {
                        "not": {
                          "required": [
                            "seen_in"
                          ]
                        }
                      }
                    }
                  ]
                },
                "description": "Other names, each with a status."
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "public primary",
                        "behind login (supplied by a user)"
                      ],
                      "description": "Where the claim comes from. Left out on older evidence, which means public primary."
                    },
                    "service": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "The service id of the product whose label the page shows."
                    },
                    "label": {
                      "type": "string",
                      "pattern": "\\S",
                      "description": "The label exactly as the product shows it."
                    },
                    "support": {
                      "type": "string",
                      "enum": [
                        "direct",
                        "context-only"
                      ],
                      "description": "direct: the page shows this label for this meaning. context-only: related use or doubt; never counts for review."
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$",
                      "description": "The public page."
                    },
                    "read_on": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                      "description": "The day it was read."
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "\\S",
                      "description": "What the page shows, quoting the label."
                    }
                  },
                  "required": [
                    "service",
                    "label",
                    "support",
                    "url",
                    "read_on",
                    "note"
                  ],
                  "additionalProperties": false
                },
                "description": "Public pages that show a product's own label."
              },
              "translation_note": {
                "type": "string",
                "maxLength": 300,
                "pattern": "\\S",
                "description": "Help for translators."
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "reviewed"
                ],
                "description": "draft, or reviewed. Reviewed needs direct evidence from two makers and two stewards."
              },
              "reviewed_by": {
                "description": "The stewards who reviewed it: at least two for reviewed, none for draft.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
                }
              }
            },
            "required": [
              "label",
              "case",
              "scope",
              "why",
              "alternatives",
              "evidence",
              "translation_note",
              "status"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "reviewed"
                    }
                  }
                },
                "then": {
                  "required": [
                    "reviewed_by"
                  ],
                  "properties": {
                    "reviewed_by": {
                      "minItems": 2,
                      "uniqueItems": true
                    },
                    "evidence": {
                      "minItems": 2
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "draft"
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "reviewed_by"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "case": {
                      "const": "acronym"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "label": {
                      "pattern": "^[^a-z]*$"
                    }
                  }
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "term",
          "also_called",
          "search_terms",
          "aliases",
          "tier",
          "who",
          "heard_when",
          "plain",
          "related",
          "source",
          "uncertain"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "about",
    "words"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/irl-commons/irl-commons/main/schema/json/words.schema.json",
  "title": "words.json"
}
