{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "about": {
      "type": "string"
    },
    "words": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "checked_on": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "term": {
            "type": "string",
            "pattern": "\\S"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "tier": {
            "type": "string",
            "enum": [
              "core",
              "more"
            ]
          },
          "who": {
            "type": "string",
            "enum": [
              "streamer",
              "helper",
              "both"
            ]
          },
          "heard_when": {
            "type": "string"
          },
          "plain": {
            "type": "string",
            "pattern": "\\S"
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "source": {
            "type": "string",
            "pattern": "\\S"
          },
          "uncertain": {
            "type": "boolean"
          },
          "l10n": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "term": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "plain": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "heard_when": {
                  "type": "string"
                }
              },
              "required": [
                "term",
                "plain"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "checked_on",
          "term",
          "aliases",
          "tier",
          "who",
          "heard_when",
          "plain",
          "related",
          "source",
          "uncertain"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "about",
    "words"
  ],
  "additionalProperties": false,
  "title": "words.json"
}
