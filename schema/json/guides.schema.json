{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "about": {
      "type": "string",
      "description": "What this file holds, in a sentence or two, with a link to the docs."
    },
    "guides": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Permanent id, used as an anchor and in links from other files."
          },
          "checked_on": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "The day the entry was compared with its public source."
          },
          "title": {
            "type": "string",
            "pattern": "\\S",
            "description": "The page's own title."
          },
          "title_display": {
            "type": "string",
            "pattern": "\\S",
            "description": "Generated by scripts/titles.ts from covers, publisher and part. Never written by hand."
          },
          "url": {
            "type": "string",
            "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$",
            "description": "The tutorial."
          },
          "creator": {
            "type": "string",
            "pattern": "\\S",
            "description": "Who made it."
          },
          "publisher": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ],
            "description": "The service id of the maker who wrote it, when that maker is one of covers. Otherwise null."
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-(?:[A-Z]{2}|[0-9]{3}))?$",
            "description": "The language it is in."
          },
          "kind": {
            "type": "string",
            "enum": [
              "article",
              "video",
              "docs"
            ],
            "description": "article, video or docs."
          },
          "published": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ],
            "description": "The date the page states, or null."
          },
          "covers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": "The products it is about, as service ids."
          },
          "part": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "camera",
                "sender",
                "connections",
                "receiver",
                "obs",
                "platform"
              ],
              "description": "Where along the chain: camera (camera and mic into the sender), sender (the app or box), connections, receiver, obs, platform."
            },
            "description": "Where along the chain it helps. The first one decides the title and the group."
          },
          "words": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": "Ids of related words in words.json."
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": "Ids of quick checks in answers.json it helps with."
          }
        },
        "required": [
          "id",
          "checked_on",
          "title",
          "title_display",
          "url",
          "creator",
          "publisher",
          "language",
          "kind",
          "published",
          "covers",
          "part",
          "words",
          "answers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "about",
    "guides"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/irl-commons/irl-commons/main/schema/json/guides.schema.json",
  "title": "guides.json"
}
