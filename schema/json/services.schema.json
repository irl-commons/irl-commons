{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "about": {
      "type": "string"
    },
    "services": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "checked_on": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "enum": [
              "app",
              "relay",
              "hub",
              "hardware",
              "production",
              "community"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "streaming-app",
              "extra-connections",
              "camera-capture",
              "remote-control",
              "chat-overlays",
              "other-app",
              "relay",
              "hub",
              "production",
              "hardware",
              "community"
            ]
          },
          "class": {
            "type": "string",
            "enum": [
              "phone-app",
              "helper-app",
              "connections",
              "bonding",
              "hardware",
              "parts",
              "store",
              "cloud",
              "production",
              "building-block",
              "docs"
            ]
          },
          "hosting": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "self",
                  "service"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "maker": {
            "type": "string",
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$"
                }
              },
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "open_source": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "licence": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "public primary",
                    "behind login (supplied by a user)"
                  ]
                },
                "url": {
                  "type": "string",
                  "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$"
                },
                "read_on": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "note": {
                  "type": "string",
                  "maxLength": 300,
                  "pattern": "\\S"
                }
              },
              "required": [
                "kind",
                "url",
                "read_on",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "platforms": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "android",
                "ios",
                "windows",
                "macos",
                "linux",
                "web",
                "hardware",
                "service"
              ]
            }
          },
          "part": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "camera",
                "sender",
                "connections",
                "receiver",
                "obs",
                "platform"
              ]
            }
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "support": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$"
                }
              },
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "camera-in",
                "multi-camera"
              ]
            },
            "uniqueItems": true
          },
          "words": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "id",
          "checked_on",
          "name",
          "kind",
          "role",
          "class",
          "hosting",
          "maker",
          "url",
          "links",
          "open_source",
          "licence",
          "status",
          "description",
          "platforms",
          "part",
          "covers",
          "support",
          "tags",
          "words"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "about",
    "services"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/irl-commons/irl-commons/main/schema/json/services.schema.json",
  "title": "services.json"
}
