{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "about": {
      "type": "string",
      "description": "What this file holds, in a sentence or two, with a link to the docs."
    },
    "services": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Permanent id, used as an anchor and in links from other files."
          },
          "checked_on": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "The day the entry was compared with its public source."
          },
          "name": {
            "type": "string",
            "pattern": "\\S",
            "description": "The name as the maker writes it."
          },
          "kind": {
            "type": "string",
            "enum": [
              "app",
              "relay",
              "hub",
              "hardware",
              "production",
              "community"
            ],
            "description": "What kind of product it is. The kind limits which roles it can have."
          },
          "role": {
            "type": "string",
            "enum": [
              "streaming-app",
              "extra-connections",
              "camera-capture",
              "remote-control",
              "chat-overlays",
              "other-app",
              "relay",
              "hub",
              "production",
              "hardware",
              "community"
            ],
            "description": "What it is for, as a reader picks it. streaming-app: sends your stream. extra-connections: adds a network path. camera-capture: brings a camera or screen in. remote-control: runs OBS or the sender from another device. chat-overlays: chat, alerts, overlays and location. other-app: an app that fits none of these. relay: relays, receivers and protocols. hub: hosted hubs that go out to the platform. production: OBS and its tools. hardware: encoders, backpacks and parts. community: docs and wikis."
          },
          "class": {
            "type": "string",
            "enum": [
              "phone-app",
              "helper-app",
              "connections",
              "bonding",
              "hardware",
              "parts",
              "store",
              "cloud",
              "production",
              "building-block",
              "docs"
            ],
            "description": "Which overview it belongs in, as a streamer looks for it. phone-app: the phone app that sends the stream. helper-app: small apps around it (chat, location, remote control, a camera into the phone). connections: ways to add another network. bonding: receivers and relays that join a bonded stream, and bonding services. hardware: backpacks, encoders and kits. parts: add-ons for a box or backpack. store: shops for built backpacks, cases and parts. cloud: hosted production (cloud OBS, drop protection, restreaming). production: OBS and tools on your own computer or in the browser. building-block: protocols, libraries and media servers that apps are built from. docs: community docs and wikis."
          },
          "hosting": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "self",
                  "service"
                ],
                "description": "self: software you run on your own server or computer. service: someone runs it for you, paid or free."
              },
              {
                "type": "null"
              }
            ],
            "description": "Who runs the server side. Set for bonding and cloud entries; null where it doesn't apply."
          },
          "maker": {
            "type": "string",
            "pattern": "\\S",
            "description": "The maker or organisation that owns it."
          },
          "url": {
            "type": "string",
            "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$",
            "description": "The maker's own page."
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "What the page is, in a few words."
                },
                "url": {
                  "type": "string",
                  "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$",
                  "description": "The page's https address."
                }
              },
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false
            },
            "description": "Other official pages."
          },
          "open_source": {
            "description": "True when the code is open source. Null when unknown.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "licence": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ],
            "description": "The licence, or null."
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ],
            "description": "A release stage the maker states, such as beta or pre-release. Null for a normal release."
          },
          "description": {
            "type": "string",
            "pattern": "\\S",
            "description": "What it is, in a sentence or two, written for this list."
          },
          "sources": {
            "description": "Sources for claims the maker's page doesn't show, such as a description behind a login.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "public primary",
                    "behind login (supplied by a user)"
                  ],
                  "description": "Where the claim comes from. Left out on older evidence, which means public primary."
                },
                "url": {
                  "type": "string",
                  "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$",
                  "description": "The public page. For a description behind a login, the public login page."
                },
                "read_on": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                  "description": "The day it was read, or the day a description was supplied."
                },
                "note": {
                  "type": "string",
                  "maxLength": 300,
                  "pattern": "\\S",
                  "description": "What the page shows, in a sentence or two."
                }
              },
              "required": [
                "kind",
                "url",
                "read_on",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "platforms": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "android",
                "ios",
                "windows",
                "macos",
                "linux",
                "web",
                "hardware",
                "service"
              ],
              "description": "Where it runs. hardware: its own device. service: a hosted service."
            },
            "description": "Where it runs."
          },
          "part": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "camera",
                "sender",
                "connections",
                "receiver",
                "obs",
                "platform"
              ],
              "description": "Where along the chain: camera (camera and mic into the sender), sender (the app or box), connections, receiver, obs, platform."
            },
            "description": "Where along the chain it sits, the main part first. Empty only for community entries."
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": "For community entries (docs, wikis): the products they document. Empty otherwise."
          },
          "support": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https:\\/\\/\\S+$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "discord",
                    "forum",
                    "help",
                    "docs",
                    "contact",
                    "github"
                  ]
                },
                "checked_on": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "source": {
                  "description": "The maker's public page or README that publishes this channel.",
                  "type": "string",
                  "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$"
                }
              },
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "required": [
                      "checked_on",
                      "source"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "url": {
                        "pattern": "[dD][iI][sS][cC][oO][rR][dD](?:[aA][pP][pP])?\\.(?:[gG][gG]|[cC][oO][mM])"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "discord"
                      }
                    }
                  }
                }
              ]
            },
            "description": "Official support channels, including Discord invites published by the maker. Typed channels carry their own checked date and source."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "camera-in",
                "multi-camera",
                "scene-control"
              ],
              "description": "camera-in: takes the picture from a standalone camera (a DSLR, mirrorless or action camera) over HDMI, USB or the network. multi-camera: shows several cameras in one scene at once. scene-control: switches the scenes in OBS or a hub from outside it, by remote, chat commands or on its own."
            },
            "uniqueItems": true
          },
          "words": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": "Ids of related words in words.json."
          }
        },
        "required": [
          "id",
          "checked_on",
          "name",
          "kind",
          "role",
          "class",
          "hosting",
          "maker",
          "url",
          "links",
          "open_source",
          "licence",
          "status",
          "description",
          "platforms",
          "part",
          "covers",
          "support",
          "tags",
          "words"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "about",
    "services"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/irl-commons/irl-commons/main/schema/json/services.schema.json",
  "title": "services.json"
}
