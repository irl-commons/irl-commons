{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "about": {
      "type": "string"
    },
    "answers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "checked_on": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "question": {
            "type": "string",
            "pattern": "\\S"
          },
          "summary": {
            "type": "string",
            "maxLength": 220,
            "pattern": "\\S"
          },
          "checks": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "part": {
                  "type": "string",
                  "enum": [
                    "camera",
                    "sender",
                    "connections",
                    "receiver",
                    "obs",
                    "platform"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 140,
                  "pattern": "\\S"
                }
              },
              "required": [
                "text"
              ],
              "additionalProperties": false
            }
          },
          "words": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https:\\/\\/(?![^/]*discord(?:app)?\\.(?:gg|com))\\S+$"
                }
              },
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "checked_on",
          "question",
          "summary",
          "checks",
          "words",
          "services",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "about",
    "answers"
  ],
  "additionalProperties": false,
  "title": "answers.json"
}
