{
  "name": "@irl-commons/data",
  "version": "0.3.0",
  "description": "Open data for IRL streaming: a glossary, troubleshooting checks, apps and services, guides, and formats and protocols. JSON Schemas included.",
  "type": "module",
  "license": "(MIT AND CC-BY-4.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irl-commons/irl-commons.git"
  },
  "homepage": "https://github.com/irl-commons/irl-commons#readme",
  "bugs": {
    "url": "https://github.com/irl-commons/irl-commons/issues"
  },
  "packageManager": "bun@1.4.3",
  "files": [
    "data/*.json",
    "data/README.md",
    "schema/src/*.ts",
    "schema/json/*.json",
    "schema/README.md",
    "scripts/*.ts",
    "LICENSE",
    "LICENSE-DATA",
    "README.md",
    "schema/fixtures/*.json",
    "NPM-PUBLISHING.md",
    "GOVERNANCE.md",
    "CONTRIBUTING.md",
    ".nvmrc"
  ],
  "exports": {
    "./data/*.json": "./data/*.json",
    "./schema/json/*.json": "./schema/json/*.json",
    "./schema": "./schema/src/schema.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "bun scripts/check.ts",
    "export": "bun scripts/export.ts",
    "titles": "bun scripts/titles.ts",
    "aliases": "bun scripts/aliases.ts",
    "watch": "bun scripts/catalogue-watch/main.ts",
    "discover:questions": "bun scripts/discovery/main.ts questions"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.14.0",
    "bun": ">=1.4.3"
  }
}
